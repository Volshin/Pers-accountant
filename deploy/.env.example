# Copy to /home/volshin/PersAccountant/.env and fill in your values

# Ollama server address (use LAN IP, not localhost, if Ollama runs on another machine)
OLLAMA_HOST=http://172.20.10.x:11434

# Ollama model to use for categorization
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0

# Directory for inbox/, done/, reports/ folders (Samba share root)
FINANCE_DIR=/home/volshin/finance
